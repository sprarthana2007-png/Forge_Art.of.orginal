{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "debugpy",
            "request": "launch",
            "name": "FORGE dashboard (Streamlit)",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/surabhi/app.py"
            ],
            "cwd": "${workspaceFolder}/surabhi",
            "console": "integratedTerminal",
            "serverReadyAction": {
                "pattern": "Local URL: (http://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        },
        {
            "type": "editor-browser",
            "request": "launch",
            "name": "Launch Integrated Browser against localhost",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        }
    ]
}
